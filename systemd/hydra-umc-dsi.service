#
# systemd unit that launches this app fullscreen, without any window
# manager chrome, on the CM5's own DSI touchscreen at boot - the piece
# mejoras_futuras.txt item 2 flagged as missing. Chosen over flutter-pi
# (the other candidate documented in README.md) specifically because it
# reuses build_linux.sh's own real `flutter build linux` output unmodified
# through cage (github.com/cage-kiosk/cage), a minimal Wayland kiosk
# compositor that runs exactly one fullscreen client and nothing else -
# flutter-pi instead needs its own separate build step against the Flutter
# engine directly, so it isn't a drop-in on top of the build this repo
# already produces.
#
# HONESTY NOTE: authored and reviewed, never actually run against a real
# CM5 or any other Linux box - there is no Linux machine available in the
# environment this was written in (see mejoras_futuras.txt item 1 /
# README.md "Honesty note on Linux verification"). Treat the first real
# `systemctl start hydra-umc-dsi.service` on real hardware as the first
# real test of this unit, not a formality - GPU/DRM device permissions,
# seatd/logind availability, and cage's own exact CLI flags can all differ
# across Raspberry Pi OS image versions in ways that aren't checkable from
# here.
#
# NOT ROOT: the app parses JSON and picture streams from the network, so it runs
# as its own account, hydra-dsi, created by install_kiosk.sh (a system user with
# no login shell, in the groups video, render and input). The unit is hardened:
# no new privileges, no capabilities, a private /tmp, read-only /usr and /etc,
# no access to the homes, no kernel modules or logs, only the address families
# the app uses (AF_NETLINK stays: the mDNS discovery needs it). The state of the
# app (its preferences) lives in /var/lib/hydra-dsi. The backlight is written
# through a udev rule (kiosk/90-hydra-dsi-backlight.rules) that gives the video
# group the right to write brightness; /sys is therefore NOT made read-only here.
# Which of these directives the CM5 image accepts is the first thing to check
# on the board (journalctl -u hydra-umc-dsi.service).
#
# APP PATH: the program that cage starts is HYDRA_DSI_APP (default below). To run another
# build, put HYDRA_DSI_APP=/path/to/hydra_umc_dsi in /etc/hydra-umc/dsi.env (optional file,
# no secrets in it); the file wins over the default. install_kiosk.sh installs this unit
# from this folder.
#
# LOCAL SCREEN: this unit starts only when the setting HYDRA_LOCAL_SCREEN is dsi
# (see local_screen.sh). It reads /etc/hydra-umc/local-screen.conf, and
# ExecCondition skips the start, without a failure, for hdmi (the default) and
# none, so it never takes tty1 from the HDMI kiosk of HYDRA-UMC-OS.
# =============================================================================

[Unit]
Description=HYDRA-UMC DSI kiosk (cage + flutter build linux bundle)
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
After=getty@tty1.service
# Restart limit: at most 5 starts in 5 minutes, then the unit stays failed (a crash loop does not spin forever).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hydra-dsi
Group=hydra-dsi
SupplementaryGroups=video render input
# A login session for cage (seat and runtime directory) without a getty.
PAMName=login
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/hydra-umc/local-screen.conf
ExecCondition=/bin/sh -c 'test "$${HYDRA_LOCAL_SCREEN:-hdmi}" = dsi'
# The settings file of the panel (kiosk/dsi.conf.example): every tunable lives there, none in the code.
Environment=HYDRA_DSI_CONFIG=/etc/hydra-umc/dsi.conf
Environment=HYDRA_DSI_APP=/opt/hydra-umc-dsi/bundle/hydra_umc_dsi
EnvironmentFile=-/etc/hydra-umc/dsi.env
Environment=HOME=/var/lib/hydra-dsi
Environment=XDG_DATA_HOME=/var/lib/hydra-dsi/data
Environment=XDG_CONFIG_HOME=/var/lib/hydra-dsi/config
StateDirectory=hydra-dsi
ExecStart=/usr/bin/cage -- ${HYDRA_DSI_APP}
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=2

# Hardening (see the header). Nothing here asks for more rights than the app has.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

# a real, initial cgroup memory ceiling - conservative defaults, meant to be refined once real telemetry from this service running on the CM5 exists, never removed back to unlimited.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=graphical.target
