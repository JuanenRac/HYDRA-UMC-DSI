# `flutter gen-l10n` output (see l10n.yaml, pubspec.yaml's `generate: true`) -
# regenerated from lib/l10n/app_*.arb by every `flutter pub get`/build/test.
# The real source of truth is the .arb files, which stay tracked.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# HYDRA-UMC shared secret protection
.env
.env.*
!.env.example
